<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="14.0" prefHeight="650.0" prefWidth="900.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.evaluacionpractica.laboratorio_guiado_concurrencia_javafx_github.controlador.SolicitudesControlador"
      style="-fx-background-color: #f1f5f9;">

    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <!-- Encabezado de la pantalla -->
    <VBox spacing="3.0">
        <Label text="Gestión de Solicitudes (CRUD)" textFill="#0f172a">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        <Label text="Módulo interactivo de registro, edición y visualización de solicitudes" textFill="#64748b">
            <font>
                <Font size="13.0" />
            </font>
        </Label>
    </VBox>

    <!-- Tarjeta del Formulario de Entrada -->
    <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 14;">
        <Label text="Datos de la Solicitud" textFill="#334155">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <GridPane hgap="12.0" vgap="10.0">
            <!-- Fila 1: Solicitante y Prioridad -->
            <Label text="Solicitante:" GridPane.columnIndex="0" GridPane.rowIndex="0" textFill="#1e293b" />
            <TextField fx:id="txtSolicitante" promptText="Nombre completo (máx 40 caracteres)" prefHeight="32.0" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Prioridad:" GridPane.columnIndex="2" GridPane.rowIndex="0" textFill="#1e293b" />
            <ComboBox fx:id="cmbPrioridad" promptText="Seleccionar..." prefHeight="32.0" prefWidth="180.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <!-- Fila 2: Asunto -->
            <Label text="Asunto:" GridPane.columnIndex="0" GridPane.rowIndex="1" textFill="#1e293b" />
            <TextField fx:id="txtAsunto" promptText="Descripción detallada de la solicitud (máx 80 caracteres)" prefHeight="32.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1" />
        </GridPane>

        <!-- Barra de Botones de Acción -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Button fx:id="btnCrear" text="Crear" onAction="#onCrear" prefHeight="32.0" prefWidth="90.0"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />

            <Button fx:id="btnActualizar" text="Actualizar" onAction="#onActualizar" prefHeight="32.0" prefWidth="100.0"
                    style="-fx-background-color: #0d9488; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />

            <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar" prefHeight="32.0" prefWidth="90.0"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />

            <Button fx:id="btnLimpiar" text="Limpiar" onAction="#onLimpiar" prefHeight="32.0" prefWidth="90.0"
                    style="-fx-background-color: #e2e8f0; -fx-text-fill: #334155; -fx-cursor: hand;" />

            <!-- Separador flexible -->
            <Pane HBox.hgrow="ALWAYS" />

            <Button fx:id="btnCargarEjemplos" text="Cargar 5 Ejemplos" onAction="#onCargarEjemplos" prefHeight="32.0" prefWidth="150.0"
                    style="-fx-background-color: #7c3aed; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
        </HBox>
    </VBox>

    <!-- Tabla de Solicitudes -->
    <VBox VBox.vgrow="ALWAYS" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 10;">
        <TableView fx:id="tblSolicitudes" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60.0" />
                <TableColumn fx:id="colSolicitante" text="Solicitante" prefWidth="190.0" />
                <TableColumn fx:id="colAsunto" text="Asunto" prefWidth="270.0" />
                <TableColumn fx:id="colPrioridad" text="Prioridad" prefWidth="100.0" />
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="110.0" />
                <TableColumn fx:id="colAtendidaPor" text="Atendida Por" prefWidth="120.0" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- Barra de Estado / Resumen -->
    <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 8 14;">
        <Label text="Resumen:" textFill="#475569">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>
        <Label fx:id="lblResumen" text="Pendientes: 0 · En proceso: 0 · Atendidas: 0" textFill="#0f172a">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>
    </HBox>

</VBox>
