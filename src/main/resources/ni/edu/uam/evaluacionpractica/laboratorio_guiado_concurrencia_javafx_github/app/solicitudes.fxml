<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.evaluacionpractica.laboratorio_guiado_concurrencia_javafx_github.controlador.SolicitudesControlador">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Gestión de Solicitudes">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <HBox spacing="15.0" alignment="CENTER_LEFT">
            <children>
                <Button fx:id="btnGenerarSolicitudes" mnemonicParsing="false" onAction="#generarCargaTrabajo" text="Generar Carga de Trabajo" />
                <Button fx:id="btnProcesar" mnemonicParsing="false" onAction="#procesarLote" text="Procesar Lote" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Progreso:" />
                <ProgressBar fx:id="barraProgreso" prefWidth="300.0" progress="0.0" />
                <Label fx:id="lblProgreso" text="0%" />
            </children>
        </HBox>
        <TableView fx:id="tablaSolicitudes" prefHeight="300.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="75.0" text="ID Solicitud" />
                <TableColumn fx:id="colEstado" prefWidth="150.0" text="Estado" />
                <TableColumn fx:id="colVentanilla" prefWidth="150.0" text="Procesado Por" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>