<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.evaluacionpractica.laboratorio_guiado_concurrencia_javafx_github.controlador.PrincipalControlador">
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <Tab text="Ventanillas (Concurrencia)">
                    <content>
                        <fx:include source="ventanillas.fxml" />
                    </content>
                </Tab>
                <Tab text="Monitor de Hilos">
                    <content>
                        <fx:include source="hilos.fxml" />
                    </content>
                </Tab>
                <Tab text="Solicitudes">
                    <content>
                        <fx:include source="solicitudes.fxml" />
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>