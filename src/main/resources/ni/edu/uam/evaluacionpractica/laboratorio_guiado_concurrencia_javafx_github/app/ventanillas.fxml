<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.evaluacionpractica.laboratorio_guiado_concurrencia_javafx_github.controlador.VentanillasControlador">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Simulación de Ventanillas Concurrentes">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <HBox spacing="15.0" alignment="CENTER_LEFT">
            <children>
                <Button fx:id="btnIniciar" mnemonicParsing="false" onAction="#iniciarProceso" text="Iniciar Ventanillas" />
                <Button fx:id="btnDetener" disable="true" mnemonicParsing="false" onAction="#detenerProceso" text="Detener Ventanillas" />
            </children>
        </HBox>
        <HBox spacing="30.0">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Estado Global:" textFill="#555555" />
                        <Label fx:id="etiquetaEstado" text="Detenido">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Contador de Operaciones:" textFill="#555555" />
                        <Label fx:id="etiquetaContador" text="0">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>
        <Label text="Área de Registro de Eventos:" />
        <TextArea fx:id="areaRegistro" editable="false" prefHeight="300.0" VBox.vgrow="ALWAYS" />
    </children>
</VBox>